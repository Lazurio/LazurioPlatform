UNREACHABLE_SECONDS = _env_float("BUDICEK_UNREACHABLE_SECONDS", 180)
CMD_TIMEOUT = _env_float("BUDICEK_CMD_TIMEOUT", 90)
WAIT_TIMEOUT = os.environ.get("BUDICEK_WAIT_TIMEOUT", "5s")
