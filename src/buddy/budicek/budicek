# Record states. `budi` (outcome saved, wake not yet confirmed on the board) and
# `eskaluje` (direct message not yet confirmed) are the crash-safe in-between
# steps; `nezalozen` means the wake path could not be prepared, so no bot was
# started and `zadej` failed loudly instead.
OPEN_STATES = ("zaklada", "bezi", "budi", "probuzen", "eskaluje")
CLOSED_STATES = ("vyrizeno", "eskalovano", "nezalozen")

MAX_REWAKES = 2
KANBAN_ASSIGNEE = "mausbot"  # not a Hermes profile, so the dispatcher never claims the card

