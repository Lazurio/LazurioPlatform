[Unit]
Description=Delegace: dá Buddymu vědět, jak dopadla práce jeho botů
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/delegace hlidej
Restart=always
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
