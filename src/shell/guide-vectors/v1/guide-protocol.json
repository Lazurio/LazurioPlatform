{
  "schema": "lazurio.guide-vectors.v1",
  "contract": "guide-protocol",
  "cases": [
    {
      "name": "the five types",
      "call": "guideMessage",
      "expect": {
        "play": "lazurio.guide.play",
        "started": "lazurio.guide.started",
        "done": "lazurio.guide.done",
        "closed": "lazurio.guide.closed",
        "busy": "lazurio.guide.busy"
      }
    },
    {
      "name": "v1",
      "call": "guideMajor",
      "expect": 1
    },
    {
      "name": "the vector files' schema",
      "call": "guideVectorsSchema",
      "expect": "lazurio.guide-vectors.v1"
    },
    {
      "name": "a principle",
      "call": "isExplanationId",
      "args": [
        "files"
      ],
      "expect": true
    },
    {
      "name": "a page's explanation",
      "call": "isExplanationId",
      "args": [
        "files-team"
      ],
      "expect": true
    },
    {
      "name": "one letter",
      "call": "isExplanationId",
      "args": [
        "a"
      ],
      "expect": true
    },
    {
      "name": "64 characters",
      "call": "isExplanationId",
      "args": [
        {
          "$repeat": "a",
          "times": 64
        }
      ],
      "expect": true
    },
    {
      "name": "65 characters",
      "call": "isExplanationId",
