{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.io/schemas/lazurio-machine.v1.schema.json",
  "title": "lazurio.machine.json — identity of one Machine written at its handover",
  "description": "Exactly one branch applies: an Organization workspace VM on a virtualization host, or the one hosted personal VM of a Principal on a provider estate. The branches are distinguished by machine.kind and never mix owner or host kinds.",
  "oneOf": [{ "$ref": "#/$defs/organization_workspace_vm" }, { "$ref": "#/$defs/personal_vm" }],
  "$defs": {
    "organization_workspace_vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "machine", "owner", "operator", "host", "installed", "account"],
      "properties": {
        "schema_version": { "const": "lazurio.machine.v1" },
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "name", "vmid"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "kind": { "const": "workspace-vm" },
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
            "vmid": { "$ref": "#/$defs/vmid" }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "organization"],
          "properties": {
            "kind": { "const": "organization" },
            "organization": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "organization_key": { "type": "string", "minLength": 1, "maxLength": 128 },
            "team": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "assignment": { "$ref": "#/$defs/organization_assignment" }
          }
        },
        "operator": { "$ref": "#/$defs/operator" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "machine_id", "custody_repository", "provider"],
          "properties": {
            "kind": { "const": "virtualization-host" },
            "machine_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "custody_repository": { "$ref": "#/$defs/repository" },
            "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        },
        "network": { "$ref": "#/$defs/network" },
        "relationships": { "allOf": [{ "$ref": "#/$defs/relationships" }, { "type": "object", "properties": { "zone": { "const": "work" } } }] },
        "installed": { "$ref": "#/$defs/installed" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "personal_vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "machine", "owner", "operator", "host", "network", "installed", "account"],
      "properties": {
        "schema_version": { "const": "lazurio.machine.v1" },
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "name", "vmid"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "kind": { "const": "personal-vm" },
            "name": { "description": "DNS slug of the Machine: <app>.<name>.lazurio.io", "type": "string", "maxLength": 32, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "vmid": { "$ref": "#/$defs/vmid" }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "github_login", "github_id"],
          "properties": {
            "kind": { "const": "principal" },
            "github_login": { "type": "string", "maxLength": 39, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "github_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        "operator": { "$ref": "#/$defs/operator" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "estate_id", "custody_repository", "record_path"],
          "properties": {
            "kind": { "const": "provider-estate" },
            "estate_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "custody_repository": { "$ref": "#/$defs/repository" },
            "record_path": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$" }
          }
        },
        "network": { "$ref": "#/$defs/network" },
        "relationships": { "allOf": [{ "$ref": "#/$defs/relationships" }, { "type": "object", "properties": { "zone": { "const": "personal" } } }] },
        "installed": { "$ref": "#/$defs/installed" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "organization_assignment": {
      "description": "Explicit assignment of an Organization work VM, authored per guest in the owner Deployment Repo and never inferred from names, Team names or Team size: one individual operator, or a shared Team. Omitted when the owner declares none; consumers then must not guess.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "github_login", "github_id"],
          "properties": {
            "kind": { "const": "operator" },
            "github_login": { "type": "string", "maxLength": 39, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "github_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "team" } }
        }
      ]
    },
    "vmid": { "type": "integer", "minimum": 100, "maximum": 999999999 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9._-]+$" },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_user", "home", "lazurio_root"],
      "properties": {
        "os_user": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "home": { "type": "string", "pattern": "^/home/[a-z][a-z0-9-]{0,31}$" },
        "lazurio_root": { "type": "string", "pattern": "^/home/[a-z][a-z0-9-]{0,31}/Lazurio$" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headscale_server_url", "headscale_hostname"],
      "properties": {
        "headscale_server_url": { "type": "string", "pattern": "^https://[a-z0-9.-]+/?$" },
        "headscale_hostname": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "installed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machines_release", "deployment_head", "recorded_at"],
      "properties": {
        "machines_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "version", "commit"],
          "properties": {
            "repository": { "$ref": "#/$defs/repository" },
            "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
            "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
          }
        },
        "deployment_head": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "recorded_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "zone": { "enum": ["personal", "work"] },
    "relationships": {
      "description": "This Machine's tailnet peers from its own point of view, derived only from the home Conglomerate Host grants that name its Headscale node. Names only: no node ids, machine keys, tailnet addresses or credentials. Omitted when the Deployment Repo declares no home Conglomerate Host for the Machine. Transport is not authentication: SSH keys and application sign-in stay separate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "peers"],
      "properties": {
        "zone": { "$ref": "#/$defs/zone" },
        "peers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "zone", "organization", "ssh", "https"],
            "properties": {
              "name": { "description": "Headscale node name of the peer.", "type": "string", "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
              "kind": { "enum": ["personal-vm", "workspace-vm", "client-device", "conglomerate-host"] },
              "zone": { "description": "Decision 0155 zone of the peer; null when the declaration does not establish it.", "anyOf": [{ "$ref": "#/$defs/zone" }, { "type": "null" }] },
              "organization": { "description": "Lowercase GitHub Organization login the peer belongs to; null for personal peers or when not established.", "anyOf": [{ "type": "string", "maxLength": 39, "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$" }, { "type": "null" }] },
              "ssh": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["host", "user", "direction"],
                    "properties": {
                      "host": { "description": "MagicDNS name of the peer in the home tailnet.", "type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$" },
                      "user": { "description": "OS account on the peer when the declaration names it; otherwise null.", "anyOf": [{ "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,30}$" }, { "type": "null" }] },
                      "direction": { "description": "TCP 22 relative to this Machine: outbound (this Machine may connect to the peer), inbound (the peer may connect here) or both.", "enum": ["outbound", "inbound", "both"] }
                    }
                  }
                ]
              },
              "https": {
                "description": "Gateway hostnames of the peer this Machine may reach over TCP 443.",
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$" }
              }
            }
          }
        }
      }
    },
    "account": {
      "description": "Reserved for the Machine's Lazurio account identity issued by the Dashboard; null until that contract exists.",
      "type": "null"
    }
  }
}
