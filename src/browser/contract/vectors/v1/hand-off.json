{
  "schema": "lazurio.browser-vectors.v1",
  "contract": "hand-off",
  "cases": [
    {
      "name": "the error of a navigation the policy blocks",
      "call": "blockedNavigationError",
      "expect": "net::ERR_BLOCKED_BY_ADMINISTRATOR"
    },
    {
      "name": "a blocked sign-in page is handed off",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "https://auth.lazurio.ai/realms/lazurio/protocol/openid-connect/auth?client_id=x"
      ],
      "expect": "https://auth.lazurio.ai/realms/lazurio/protocol/openid-connect/auth?client_id=x"
    },
    {
      "name": "a blocked Dashboard page is handed off as written",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "https://dashboard.lazurio.ai/environments#current"
      ],
      "expect": "https://dashboard.lazurio.ai/environments#current"
    },
    {
      "name": "another Environment's Launchpad is handed off",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "https://launchpad.team-01.example.lazurio.io/"
      ],
      "expect": "https://launchpad.team-01.example.lazurio.io/"
    },
    {
      "name": "a blocked http address is handed off normalized",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "http://Example.lazurio.ai"
      ],
      "expect": "http://example.lazurio.ai/"
    },
    {
      "name": "any other failure is not",
      "call": "handOffAddress",
      "args": [
        "net::ERR_CONNECTION_REFUSED",
        "https://auth.lazurio.ai/"
      ],
      "expect": null
    },
    {
      "name": "a blocked request with no error text is not",
      "call": "handOffAddress",
      "args": [
        null,
        "https://auth.lazurio.ai/"
      ],
      "expect": null
    },
    {
      "name": "an address with credentials is not",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "https://user:secret@auth.lazurio.ai/"
      ],
      "expect": null
    },
    {
      "name": "a scheme other than http and https is not",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "javascript:alert(1)"
      ],
      "expect": null
    },
    {
      "name": "a file address is not",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "file:///etc/passwd"
      ],
      "expect": null
    },
    {
      "name": "no address is not",
      "call": "handOffAddress",
      "args": [
        "net::ERR_BLOCKED_BY_ADMINISTRATOR",
        "not an address"
      ],
      "expect": null
    }
  ]
}
