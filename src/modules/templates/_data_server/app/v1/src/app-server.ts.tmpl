/** The App's own server for a Module with data (Lazurio Module Standard,
 * "Applications of an Organization"): the data, the tools for agents and the
 * built interface run in one process, so all access to the data runs in the
 * server (profile `app-data`). Free of the listener, so it has unit tests. */
import { type AppAccess, appAccess } from "@lazurio/module-kit";
import { dataWriter } from "@lazurio/module-kit/tools";
import { MCP_PATH } from "./agent-tools.ts";

export const HEALTH_PATH = "/healthz";
export const SESSION_PATH = "/api/session";

type Env = Readonly<Record<string, string | undefined>>;

export interface ServerParts {
  /** The listener id the App's addresses come from. */
  listener: string;
  /** Hostnames the App answers (`allowedHosts()` of module-kit). */
  hosts: ReadonlySet<string>;
  /** The exact origins a browser's page may send requests from: the App's
   * external origin and its loopback origins (`allowedOrigins()`). */
  origins: ReadonlySet<string>;
  /** Whether the data are open: the health answers 503 until they are. */
  dataOpen: () => boolean;
  /** The tools for agents (`agentTools()`), offered at /mcp and to the page. */
  tools: {
    handleMcp(request: Request): Promise<Response>;
    handlePage(request: Request): Promise<Response | null>;
  };
  /** The interface: the built one, or in a development run Bun's bundler
   * behind this server (may answer undefined after upgrading the hot-reload
   * socket); null in a test. */
  serveClient: ((request: Request, server?: unknown) => Promise<Response | undefined>) | null;
  env?: Env;
}

/** Hostnames the App answers; anything else is refused. */
export function hostAllowed(request: Request, hosts: ReadonlySet<string>): boolean {
  const header = request.headers.get("host");
  if (header === null) return false;
  let hostname: string;
  try {
    hostname = new URL(`http://${header}`).hostname;
  } catch {
    return false;
  }
  return hosts.has(hostname.replace(/^\[(.*)\]$/, "$1"));
}

/** The exact origins of the App's own pages: `http://<loopback>:<port>` for
 * every loopback hostname the App answers, and its external origin. */
export function allowedOrigins(
  hosts: ReadonlySet<string>,
  port: number,
  externalOrigin: string | null | undefined,
): Set<string> {
  const origins = new Set<string>();
  for (const host of hosts)
    if (host !== (externalOrigin ? new URL(externalOrigin).hostname : ""))
      origins.add(`http://${host.includes(":") ? `[${host}]` : host}:${port}`);
  if (externalOrigin) origins.add(new URL(externalOrigin).origin);
  return origins;
}

/** A browser sends `Origin` on WebSocket handshakes and scripted requests:
 * when present it must be exactly one of the App's own origins (an opaque
 * `null` included is refused). A request without `Origin` is no browser's
 * cross-origin request. */
export function originAllowed(request: Request, origins: ReadonlySet<string>): boolean {
  const origin = request.headers.get("origin");
  return origin === null || origins.has(origin);
}

/** Who came and whether they may change data now: `appAccess` for every
 * request (decision 0231) and the one writer rule `dataWriter`. */
export function session(access: AppAccess, env: Env) {
  return {
    role: access.appRole,
    username: access.person?.username ?? null,
    entry: access.entry,
    mayWrite: dataWriter(access, env),
  };
}

export function createHandler(parts: ServerParts) {
  const env = parts.env ?? process.env;
  return async (request: Request, server?: unknown): Promise<Response | undefined> => {
    if (!hostAllowed(request, parts.hosts)) return new Response("Forbidden host", { status: 403 });
    // A page elsewhere never reaches the App, its data, its tools or the
    // development run's hot-reload socket.
    if (!originAllowed(request, parts.origins))
      return new Response("Forbidden origin", { status: 403 });
    const { pathname } = new URL(request.url);
    if (pathname === HEALTH_PATH) {
      const open = parts.dataOpen();
      return Response.json(open ? { status: "ok" } : { status: "starting" }, {
        status: open ? 200 : 503,
        headers: { "cache-control": "no-store" },
      });
    }
    if (pathname === MCP_PATH) return parts.tools.handleMcp(request);
    const page = await parts.tools.handlePage(request);
    if (page !== null) return page;
    if (pathname === SESSION_PATH) {
      const access = appAccess(request, parts.listener, env);
      if (access.appRole === null)
        return Response.json({ ok: false, reason: "forbidden" }, { status: 403 });
      return Response.json(session(access, env), { headers: { "cache-control": "no-store" } });
    }
    if (pathname.startsWith("/api/"))
      return Response.json({ ok: false, reason: "not_found" }, { status: 404 });
    if (parts.serveClient && (request.method === "GET" || request.method === "HEAD")) {
      // The page and its files too need an application role (decision 0231).
      if (appAccess(request, parts.listener, env).appRole === null)
        return new Response("Forbidden", { status: 403 });
      return parts.serveClient(request, server);
    }
    return new Response("Not found", { status: 404 });
  };
}

/** Serves the built interface from `root`; an unknown path gets `index.html`
 * when `spa` is true (client routing), otherwise its `index.html` or 404. */
export function staticFiles(root: string, spa: boolean) {
  return async (pathname: string): Promise<Response> => {
    const clean = decodeURIComponent(pathname).replace(/\\/g, "/");
    if (clean.split("/").includes("..")) return new Response("Not found", { status: 404 });
    const candidates = clean.endsWith("/")
      ? [`${clean}index.html`]
      : [clean, `${clean}/index.html`, `${clean}.html`];
    for (const candidate of candidates) {
      const file = Bun.file(`${root}${candidate}`);
      if (await file.exists()) return new Response(file);
    }
    if (spa) {
      const index = Bun.file(`${root}/index.html`);
      if (await index.exists()) return new Response(index);
    }
    return new Response("Not found", { status: 404 });
  };
}
