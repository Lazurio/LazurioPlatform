{
  "name": "{{slug}}-app-{{app_generation}}",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@{{bun_version}}",
  "scripts": {
    "dev": "bun --no-env-file ./node_modules/vite/bin/vite.js",
    "build": "bun ./node_modules/vite/bin/vite.js build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:prepared": "bun run src/prepared.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@lazurio/module-kit": "github:Lazurio/module-kit#v{{module_kit_version}}",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "{{bun_version}}",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "{{runtime_id}}",
      "title": "{{display_name}}",
      "company": "{{organization}}",
      "module": "{{slug}}",
      "surface": "internal",
      "dev_script": "dev",
      "build_script": "build",
      "build_output": "dist",
      "static_fallback": "spa",
      "tags": [
        "{{slug}}"
      ],
      "listeners": [
        {
          "id": "{{listener_id}}",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "{{app_directory}}/package.json",
      "check_script": "check:prepared"
    }
  }
}
