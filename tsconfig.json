{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "proof/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
